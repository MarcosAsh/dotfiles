#!/usr/bin/env bash
# Back up home to the gaming PC with restic. The restic-backup timer runs
# "backup run", anything else is passed straight to restic, so
# "backup snapshots" or "backup restore latest --target /tmp/r" work too.
# Each run is reported to the homelab Pushgateway as job="backup", target="laptop".
set -euo pipefail

export RESTIC_REPOSITORY="sftp:marcos@192.168.0.219:/home/marcos/backups/bombopulus"
export RESTIC_PASSWORD_FILE="$HOME/.config/restic/password"
RESTIC="$HOME/.local/bin/restic"
EXCLUDES="$HOME/.config/restic/excludes"
PUSHGATEWAY="http://192.168.0.156:30091/metrics/job/backup/target/laptop"

# Away from home the Pushgateway isn't reachable, so this fails quietly
push_metrics() {
    curl -sf -m 5 --data-binary @- "$PUSHGATEWAY" >/dev/null 2>&1 || true
}

case "${1:-run}" in
    run)
        status=0
        summary=$("$RESTIC" backup "$HOME" --exclude-file "$EXCLUDES" --exclude-caches \
            --one-file-system --tag auto --json | tail -n 1) || status=$?
        added=$(jq -r 'select(.message_type == "summary") | .data_added' <<< "$summary" 2>/dev/null || true)
        echo "backup finished with status $status, ${added:-unknown} bytes added"
        if [ "$status" -eq 0 ]; then
            "$RESTIC" forget --tag auto --keep-hourly 24 --keep-daily 14 \
                --keep-weekly 8 --keep-monthly 12 || status=$?
        fi
        size=$("$RESTIC" stats --mode raw-data --json 2>/dev/null | jq -r '.total_size // empty' || true)
        now=$(date +%s)
        {
            echo "backup_last_run_timestamp_seconds $now"
            echo "backup_last_status $status"
            if [ "$status" -eq 0 ]; then echo "backup_last_success_timestamp_seconds $now"; fi
            if [ -n "$added" ]; then echo "backup_added_bytes $added"; fi
            if [ -n "$size" ]; then echo "backup_repo_size_bytes $size"; fi
        } | push_metrics
        exit "$status"
        ;;
    prune)
        "$RESTIC" prune
        ;;
    *)
        exec "$RESTIC" "$@"
        ;;
esac
